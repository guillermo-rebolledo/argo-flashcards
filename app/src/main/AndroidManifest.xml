<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The one request the app makes: the Anthropic API, from the device. See ADR 0002. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Asked for at the moment the user turns reminders on, never at launch. Declaring it here
      is not asking for it: on Android 13 and above the prompt is a runtime one, and the app
      has no business showing it before the user has said they want to be reminded.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Backup is on now that there are rules to keep the API key out of it. Both files list
      what goes rather than what stays, so a file added later is excluded until someone says
      otherwise — the credential cannot be swept in by a rule nobody revisited. allowBackup
      covers Android 11 and below, dataExtractionRules covers 12 and above.
    -->
    <application
        android:name=".FlashcardsApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Flashcards">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Flashcards">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          WorkManager's own initialiser is removed so the app can supply the Hilt worker
          factory instead — see FlashcardsApplication. Without this the reminder worker would
          be built by the default factory, which cannot give it its dependencies.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
