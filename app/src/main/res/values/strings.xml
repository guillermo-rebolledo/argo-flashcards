<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name">Flashcards</string>

    <string name="destination_decks">Decks</string>
    <string name="destination_progress">Progress</string>
    <string name="destination_settings">Settings</string>

    <string name="action_cancel">Cancel</string>
    <string name="action_save">Save</string>
    <string name="action_edit">Edit</string>
    <string name="action_delete">Delete</string>
    <string name="action_go_back">Go back</string>
    <string name="action_close">Close</string>
    <string name="action_remove">Remove</string>

    <string name="generate_title">Add cards</string>
    <string name="generate_headline">Paste some text</string>
    <string name="generate_body">A few paragraphs is enough. Cards come back as one idea each.</string>
    <string name="generate_placeholder">Paste your notes</string>
    <!-- What the app made of what was pasted, before anything is generated from it. -->
    <plurals name="generate_word_count">
        <item quantity="one">%1$d word</item>
        <item quantity="other">%1$d words</item>
    </plurals>
    <string name="generate_action">Generate cards</string>
    <string name="generate_write_them_myself">Write them myself</string>
    <!-- Said plainly, because a wait with nothing on screen reads as the app having frozen. -->
    <string name="generate_busy_title">Writing your cards</string>
    <string name="generate_busy_body">This takes a few seconds. There is nothing to do here.</string>
    <string name="generate_review_title">Generated cards</string>
    <!-- The count is of Cards Kept, so it moves as they untick. Not a plural: it reads the
         same at every number, and "0 of 7" is a state the user can be in. -->
    <string name="generate_kept_summary" tools:ignore="PluralsCandidate">%1$d of %2$d cards kept · untick anything that does not help</string>
    <plurals name="generate_save">
        <item quantity="one">Save %1$d card</item>
        <item quantity="other">Save %1$d cards</item>
    </plurals>
    <string name="generate_open_settings">Open settings</string>
    <string name="generate_try_again">Try again</string>
    <!-- Each failure says what happened and, above all, what to do next. The first one is the
         one every new install meets, and it must not read as something being broken. -->
    <string name="generate_error_no_key">Generating cards needs your own Anthropic API key. Add one in Settings and this will be waiting.</string>
    <string name="generate_error_invalid_key">Anthropic turned that key down. Check it in Settings — what you pasted here is fine.</string>
    <string name="generate_error_rate_limited">Anthropic is asking you to slow down. Give it a minute and try again.</string>
    <string name="generate_error_offline">No connection. Cards are written by Anthropic, so this one needs you online.</string>
    <string name="generate_error_timeout">That took longer than it should have. Try again, or paste a shorter piece.</string>
    <string name="generate_error_declined">The model declined to write cards from this. Different material should be fine.</string>
    <string name="generate_error_no_cards">Nothing usable came back. Try a shorter piece, or one with more to remember in it.</string>
    <string name="generate_error_unexpected">Anthropic could not be reached just now. Try again in a moment.</string>

    <string name="decks_add_cards">Add cards</string>
    <string name="decks_new_deck">New deck</string>
    <string name="decks_create">Create</string>
    <string name="decks_rename">Rename</string>
    <string name="decks_name_label">Deck name</string>
    <string name="decks_options_for">More options for %1$s</string>
    <string name="decks_delete_title">Delete %1$s?</string>
    <string name="decks_delete_body">This Deck goes for good. There is no undo.</string>
    <string name="decks_empty_title">No Decks yet</string>
    <string name="decks_empty_body">Your Decks will show up here. Tap Add cards to paste something in, or to write your first Deck yourself.</string>

    <string name="cards_add_card">Add card</string>
    <string name="cards_new_card">New card</string>
    <string name="cards_edit_card">Edit card</string>
    <string name="cards_add">Add</string>
    <string name="cards_front_label">Front</string>
    <string name="cards_back_label">Back</string>
    <string name="cards_front_supporting">One idea per card</string>
    <string name="cards_options_for">More options for %1$s</string>
    <string name="cards_delete_title">Delete “%1$s”?</string>
    <string name="cards_delete_body">This Card goes for good. There is no undo.</string>
    <!--
        Not a plural: "Mastered" is the state the Cards are in, not a noun the count inflects,
        and "1 of 1 Mastered" reads the same as "8 of 12 Mastered".
    -->
    <string name="cards_mastery_summary" tools:ignore="PluralsCandidate">%1$d of %2$d Mastered</string>
    <string name="cards_filter_all">All</string>
    <string name="cards_filter_learning">Learning</string>
    <string name="cards_filter_mastered">Mastered</string>
    <string name="cards_empty_title">No Cards yet</string>
    <string name="cards_empty_body">A Card has a Front and a Back — one idea, never two. Tap Add card to write your first.</string>
    <string name="cards_none_learning_title">Nothing left to learn</string>
    <string name="cards_none_learning_body">Every Card in this Deck is Mastered.</string>
    <string name="cards_none_mastered_title">Nothing Mastered yet</string>
    <!-- The count comes from Card.MASTERY_THRESHOLD, so the copy cannot outlive the rule. -->
    <string name="cards_none_mastered_body">A Card is Mastered once its Mastery streak reaches %1$d.</string>

    <string name="session_start">Start session</string>
    <string name="session_end">End session</string>
    <!-- Which Card the user is on, not how many are behind them: "3 of 5". -->
    <string name="session_position">%1$d of %2$d</string>
    <string name="session_tap_to_reveal">Tap to reveal</string>
    <string name="session_again">Again</string>
    <string name="session_knew_it">Knew it</string>
    <!-- Says the swipe exists at all: nothing on a Card suggests it can be thrown. Names the
         two Grades, so it reads as the buttons and the drag hints do. -->
    <string name="session_swipe_hint">Swipe right for Knew it, left for Again</string>
    <string name="session_done_title">Session done</string>
    <!-- The score, not a count of anything: "3 of 5" remembered. -->
    <string name="session_score">%1$d of %2$d</string>
    <string name="session_score_caption">remembered on the first pass</string>
    <string name="session_misses_title">Worth another look</string>
    <!-- The results screen's job beyond the score: a short Session is a complete Session. -->
    <string name="session_reassurance">Two minutes is a full Session. Nothing is waiting for you tomorrow if you skip it.</string>
    <string name="session_review_misses">Review the misses</string>
    <string name="session_done">Done</string>
    <string name="session_empty_title">Nothing to review</string>
    <string name="session_empty_body">This Deck has no Cards yet. Add one and it will be waiting here.</string>

    <string name="decks_up_next">Up next</string>
    <!-- A Deck can hold a single Card, so the count inflects. -->
    <plurals name="decks_card_count">
        <item quantity="one">%1$d Card</item>
        <item quantity="other">%1$d Cards</item>
    </plurals>
    <!-- %1$s is that count; the rest reads the same at every number. -->
    <string name="decks_up_next_summary">%1$s · %2$d of %3$d Mastered</string>
    <string name="decks_see_cards">See cards</string>
    <string name="decks_your_decks">Your Decks</string>

    <!-- A streak of one day is a streak: "1 day in a row" is what the first Session earns. -->
    <plurals name="progress_streak_days">
        <item quantity="one">%1$d day</item>
        <item quantity="other">%1$d days</item>
    </plurals>
    <string name="progress_streak_caption">in a row</string>
    <!-- The dots are a picture of the week; the day each one stands for is said out loud only
         to a screen reader, which cannot see the row. -->
    <string name="progress_day_studied">%1$s, studied</string>
    <string name="progress_day_not_studied">%1$s, not studied</string>
    <string name="progress_last_seven_days">Last seven days</string>
    <string name="progress_tile_cards">cards</string>
    <string name="progress_tile_minutes">minutes</string>
    <string name="progress_tile_decks">decks</string>
    <!-- Names the day and stops. The line under it is the point of the whole screen: a gap is
         something the streak holds for you, never something you are told off for. -->
    <string name="progress_skipped_title">You skipped %1$s</string>
    <string name="progress_skipped_body">The streak holds your place. Pick it back up whenever you have two minutes.</string>
    <string name="progress_decks_this_week">Decks touched this week</string>
    <string name="progress_empty_title">Nothing here yet</string>
    <string name="progress_empty_body">Finish a Session and your week shows up here — the days you studied, and the Decks you spent them on.</string>

    <string name="settings_focus">Focus</string>
    <string name="settings_reduced_motion">Reduced motion</string>
    <string name="settings_reduced_motion_body">Cards change without sliding or rotating</string>
    <!-- Replaces the line above when the device is already asking for reduced motion, so the
         toggle sitting off next to still Cards reads as explained rather than as broken. -->
    <string name="settings_reduced_motion_system">Already on in your device\'s accessibility settings</string>
    <string name="settings_hide_streak">Hide streak counter</string>
    <string name="settings_hide_streak_body">Keep progress out of sight until you ask for it</string>
    <string name="settings_session_length">Session length</string>
    <!-- Why there are three chips and not a number field: the end has to stay in sight. -->
    <string name="settings_session_length_body">Every Session ends where you can see it.</string>
    <!-- A chip: "5 Cards". Not a plural — the smallest Session the app offers is 3. -->
    <string name="settings_session_length_option" tools:ignore="PluralsCandidate">%1$d Cards</string>
    <string name="settings_generation">Card generation</string>
    <string name="settings_api_key">Anthropic API key</string>
    <!-- Says where the key goes and where it does not, because the honest answer is the
         reassuring one: it is on this phone, and the only place it is ever sent is Anthropic. -->
    <string name="settings_api_key_unset">Not set. Cards are generated with your own key.</string>
    <string name="settings_api_key_set">Stored encrypted on this device.</string>
    <string name="settings_api_key_label">API key</string>
    <string name="settings_api_key_dialog_body">Generation goes straight from this phone to Anthropic with your key. It is stored encrypted, kept out of backups, and never sent anywhere else.</string>

    <!--
        The nudge itself. No count, no streak, no "cards waiting" — per ADR 0001 there is no
        backlog for it to report, and inventing one would undo the point of the whole app.
        It asks, it does not tell off, and the second line says the door is open, not overdue.
    -->
    <string name="reminder_title">Two minutes?</string>
    <string name="reminder_body">Your Decks are here whenever you want them.</string>
    <string name="reminder_channel_name">Daily reminder</string>
    <string name="reminder_channel_description">One nudge a day, at the time you chose. Never a count of anything.</string>

    <string name="settings_reminders">Reminders</string>
    <string name="settings_reminder">Daily reminder</string>
    <string name="settings_reminder_body">One nudge a day. No counts, nothing waiting.</string>
    <!-- Replaces the line above when Android is dropping the app's notifications, so the
         switch sitting off is explained rather than looking broken. Says who turned it off
         and where to undo it, because the app cannot. -->
    <string name="settings_reminder_blocked">Android is blocking notifications for Flashcards. Tap to turn them back on.</string>
    <string name="settings_reminder_time">Reminder time</string>
    <string name="settings_reminder_time_pick">Pick a reminder time</string>
    <!-- Honest about what is promised: the hour, not the minute. See ADR 0004. -->
    <string name="settings_reminder_time_body">Arrives around this time — near enough, so your battery is left alone.</string>

    <string name="settings_appearance">Appearance</string>
    <string name="settings_dark_theme">Dark theme</string>
    <string name="settings_dark_theme_body">Follows your device until you set it here</string>
</resources>
