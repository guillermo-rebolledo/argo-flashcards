<?xml version="1.0" encoding="utf-8"?>
<!--
  The Android 11-and-below counterpart to data_extraction_rules.xml. Backup is off via
  allowBackup; this states the same thing for any path that reads the rules directly.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
