<?xml version="1.0" encoding="utf-8"?>
<!--
  The Android 11-and-below counterpart to data_extraction_rules.xml, and it must say the same
  thing: Decks and Cards go, the API key does not. Named includes only, so the credential in
  `shared_prefs/credentials.xml` — and anything else added later — stays out until listed.
-->
<full-backup-content>
    <include domain="database" path="flashcards.db" />
    <include domain="database" path="flashcards.db-wal" />
    <include domain="database" path="flashcards.db-shm" />
    <include domain="file" path="datastore" />
</full-backup-content>
