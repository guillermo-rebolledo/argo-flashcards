<?xml version="1.0" encoding="utf-8"?>
<!--
  ADR 0002: Decks and Cards are backed up, the API key is not. These rules name what goes
  rather than what stays, so anything stored later is left out until someone adds it here —
  the credential cannot be swept into a backup by a rule nobody revisited.

  The key lives in `shared_prefs/credentials.xml`. Nothing in the `sharedpref` domain is
  listed below, so it is not backed up — there is no exclude to state that, because an
  exclude outside the include list is an error rather than a second lock.
-->
<data-extraction-rules>
    <cloud-backup>
        <!--
          The Room database — the only record of a Deck. All three files, because Room runs in
          write-ahead logging mode: the most recent Cards can still be sitting in `-wal` rather
          than in the database file, and a database restored without its log is a database
          missing whatever was written last. The platform does nothing about this on its own —
          an include names a starting point for a walk, and a file has nothing below it.
        -->
        <include domain="database" path="flashcards.db" />
        <include domain="database" path="flashcards.db-wal" />
        <include domain="database" path="flashcards.db-shm" />
        <!-- The settings store. A preference is cheap to lose, but free to carry over. -->
        <include domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="flashcards.db" />
        <include domain="database" path="flashcards.db-wal" />
        <include domain="database" path="flashcards.db-shm" />
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
